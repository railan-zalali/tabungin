{
  "expo": {
    "name": "Tabungin",
    "slug": "tabungin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tabungin",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D7D53"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D7D53"
      },
      "package": "com.tabungin.app"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1D7D53"
        }
      ],
      "expo-camera",
      "expo-sharing",
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "43110849-f922-4680-a3ea-66eb86d8ee72"
      }
    }
  }
}
